<% post_page_meta @post %>
<% promo = newsletter_promo(@post) %>

<%= render "posts/hero", post: @post, kicker: "Travel Newsletter" %>
<%= render layout: "posts/story", locals: { post: @post } do %><% end %>

<%# Promo: a tour or a link %>
<% if promo %>
  <section class="mx-auto max-w-[1180px] px-6 pb-28" aria-labelledby="promo-heading">
    <% if @post.promo_image.attached? %>
      <%= image_tag @post.promo_image, alt: promo.title, loading: "lazy",
            class: "block h-[260px] w-full rounded-[24px] bg-[#3a3a36] object-cover md:h-[460px]" %>
    <% end %>

    <div class="mx-auto max-w-[760px] pt-12 md:pt-16">
      <p class="text-[13px] font-semibold tracking-[.18em] text-terracotta-deep uppercase"><%= promo.kicker %></p>
      <h2 id="promo-heading" class="mt-4 font-serif text-[clamp(32px,4vw,46px)] leading-[1.08] font-medium text-balance">
        <%= promo.title %>
      </h2>

      <% if promo.paragraphs.any? %>
        <div class="mt-8 space-y-6 text-[17px] leading-[1.65] text-ink/85">
          <% promo.paragraphs.each do |paragraph| %>
            <p><%= paragraph %></p>
          <% end %>
        </div>
      <% end %>

      <%= link_to promo.button, promo.url,
            class: "mt-10 inline-flex h-[52px] items-center rounded-full bg-ink px-8 text-base text-white transition-colors hover:bg-black" %>
    </div>
  </section>
<% end %>

<%# Linked tours, as cards side by side %>
<% linked_tours = @post.bookable_promotions.map(&:tour) %>
<% if linked_tours.any? %>
  <section class="mx-auto max-w-[1180px] px-6 pb-28" aria-labelledby="linked-tours-heading">
    <div class="mx-auto max-w-[760px]">
      <p class="text-[13px] font-semibold tracking-[.18em] text-terracotta-deep uppercase">Visit with us</p>
      <h2 id="linked-tours-heading" class="mt-4 font-serif text-[clamp(32px,4vw,46px)] leading-[1.08] font-medium text-balance">
        <%= linked_tours.one? ? "The tour from this story" : "Tours from this story" %>
      </h2>
    </div>

    <div class="mt-12 grid grid-cols-[repeat(auto-fill,minmax(260px,1fr))] gap-[30px]">
      <%= render partial: "tours/card", collection: linked_tours, as: :tour %>
    </div>
  </section>
<% end %>
