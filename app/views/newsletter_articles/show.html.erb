<% post_page_meta @post %>
<% callout = newsletter_callout(@post) %>

<%= render "posts/hero", post: @post, kicker: "Travel Newsletter" %>
<%= render layout: "posts/story", locals: { post: @post } do %>
  <%# Callout: a heading, a few lines and one button per link or tour %>
  <% if callout %>
    <section class="mt-16 rounded-md border-l-[6px] border-ink bg-stepper px-7 py-9 md:px-12 md:py-11" aria-labelledby="promo-heading">
      <h2 id="promo-heading" class="text-[15px] font-semibold tracking-[.22em] text-ink/90 uppercase">Travel with us</h2>

      <% callout.paragraphs.each do |paragraph| %>
        <p class="mt-5 text-[18px] leading-[1.65] text-ink/85"><%= paragraph %></p>
      <% end %>

      <div class="mt-7 flex max-w-[480px] flex-col gap-3">
        <% callout.buttons.each do |button| %>
          <%= link_to button.url,
                class: "flex min-h-[52px] items-center rounded-xl bg-ink px-7 py-3 text-base font-semibold text-white transition-colors hover:bg-black" do %>
            <%= button.label %>&nbsp;→
          <% end %>
        <% end %>
      </div>
    </section>
  <% end %>
<% end %>
