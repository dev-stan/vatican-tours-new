<% content_for :title, "#{@article.title} — Vatican Tours Inc" %>
<% tour = @article.promoted_tour %>

<%# Hero %>
<section class="relative flex min-h-[460px] flex-col bg-[#3a3a36] bg-cover bg-center bg-no-repeat text-white md:min-h-[540px]"
         <% if @article.hero_image.attached? %>style="background-image: url('<%= url_for(@article.hero_image) %>')"<% end %>>
  <div class="pointer-events-none absolute inset-0 bg-[rgba(20,30,40,.48)]"></div>

  <%= render "shared/header" %>

  <div class="relative my-auto flex flex-col items-center px-6 pb-10 text-center md:px-16">
    <p class="text-[13px] font-semibold tracking-[.18em] text-white/85 uppercase">Travel Newsletter</p>
    <h1 class="mt-4 max-w-[960px] font-serif text-[clamp(40px,6.5vw,84px)] leading-[1.02] font-medium tracking-[-1px] text-balance">
      <%= @article.title %>
    </h1>
  </div>
</section>

<div class="mx-auto max-w-[760px] px-6 pt-10 pb-28 md:pt-14">
  <nav aria-label="Breadcrumb">
    <ol class="flex flex-wrap items-center gap-3 text-sm text-muted">
      <li><%= link_to "Home", root_path, class: "hover:text-ink" %></li>
      <li aria-hidden="true" class="text-[#c4bdb5]">/</li>
      <li><%= link_to "Newsletter", articles_path, class: "hover:text-ink" %></li>
      <li aria-hidden="true" class="text-[#c4bdb5]">/</li>
      <li class="text-ink" aria-current="page"><%= @article.title %></li>
    </ol>
  </nav>

  <p class="mt-7 text-sm text-muted">
    <time datetime="<%= @article.published_at.to_date.iso8601 %>"><%= @article.published_at.strftime("%B %-d, %Y") %></time>
  </p>

  <%# Story %>
  <div class="article-body mt-8">
    <%= @article.body %>
  </div>
</div>

<%# Promoted tour %>
<% if tour %>
  <section class="mx-auto max-w-[1180px] px-6 pb-28" aria-labelledby="tour-heading">
    <% if @article.tour_image.attached? %>
      <%= image_tag @article.tour_image, alt: tour.title, loading: "lazy",
            class: "block h-[260px] w-full rounded-[24px] bg-[#3a3a36] object-cover md:h-[460px]" %>
    <% end %>

    <div class="mx-auto max-w-[760px] pt-12 md:pt-16">
      <p class="text-[13px] font-semibold tracking-[.18em] text-terracotta-deep uppercase">Visit with us</p>
      <h2 id="tour-heading" class="mt-4 font-serif text-[clamp(32px,4vw,46px)] leading-[1.08] font-medium text-balance">
        <%= tour.title %> tour
      </h2>

      <% if (details = tour_finer_details(tour)).any? %>
        <div class="mt-8 space-y-6 text-[17px] leading-[1.65] text-ink/85">
          <% details.each do |paragraph| %>
            <p><%= paragraph %></p>
          <% end %>
        </div>
      <% end %>

      <%= link_to "Learn more about the tour", tour_path(tour),
            class: "mt-10 inline-flex h-[52px] items-center rounded-full bg-ink px-8 text-base text-white transition-colors hover:bg-black" %>
    </div>
  </section>
<% end %>
