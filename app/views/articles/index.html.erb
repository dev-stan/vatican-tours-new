<% content_for :title, "Travel Newsletter — Vatican Tours Inc" %>

<%= render "shared/header" %>

<%# Intro %>
<section class="mx-auto max-w-[1180px] px-6 pt-10 pb-12 md:pt-14">
  <nav aria-label="Breadcrumb">
    <ol class="flex flex-wrap items-center gap-3 text-sm text-muted">
      <li><%= link_to "Home", root_path, class: "hover:text-ink" %></li>
      <li aria-hidden="true" class="text-[#c4bdb5]">/</li>
      <li class="text-ink" aria-current="page">Newsletter</li>
    </ol>
  </nav>

  <h1 class="mt-7 font-serif text-[clamp(40px,6vw,72px)] leading-[1.02] font-medium tracking-[-1px] text-balance">
    Travel Newsletter / <em class="font-normal">Stories</em>
  </h1>
  <p class="mt-5 max-w-[640px] text-[17px] leading-[1.5] text-pretty text-muted">
    Notes from our guides on the places we love, the people who keep them going, and the corners most visitors never find.
  </p>
</section>

<%# Articles %>
<section class="mx-auto max-w-[1180px] px-6 pb-28" aria-label="Stories">
  <% if @articles.any? %>
    <div class="grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
      <%= render partial: "articles/card", collection: @articles, as: :article %>
    </div>
  <% else %>
    <p class="rounded-[18px] bg-white/70 p-8 text-base text-muted">New stories are on their way. Check back soon.</p>
  <% end %>
</section>
