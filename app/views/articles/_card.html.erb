<%# locals: (article:) -%>
<article class="relative flex flex-col overflow-hidden rounded-[14px] bg-white shadow-[0_1px_2px_rgba(0,0,0,.04)]">
  <div class="relative h-56 bg-black/[.04]">
    <% if article.hero_image.attached? %>
      <%= image_tag article.hero_image, alt: "", loading: "lazy", class: "absolute inset-0 block size-full object-cover" %>
    <% end %>
  </div>

  <div class="flex flex-1 flex-col px-5 pt-4 pb-6">
    <p class="text-[13px] text-muted">
      <time datetime="<%= article.published_at.to_date.iso8601 %>"><%= article.published_at.strftime("%B %-d, %Y") %></time>
    </p>
    <h2 class="mt-3 font-serif text-[23px] leading-[1.15] font-medium text-pretty">
      <%= link_to article.title, article_path(article), class: "after:absolute after:inset-0 after:rounded-[14px]" %>
    </h2>
    <% if article.excerpt.present? %>
      <p class="mt-3 text-[15px] leading-[1.55] text-pretty text-ink/75"><%= article.excerpt %></p>
    <% end %>
    <p class="mt-auto flex items-center gap-2 pt-6 text-[15px] font-medium" aria-hidden="true">
      Read the story <span>→</span>
    </p>
  </div>
</article>
