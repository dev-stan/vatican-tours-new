<%# locals: (posts:, section:, heading:, intro:, cta:) -%>
<%# A section's list page (newsletter, blog, travel tips): breadcrumb, heading, intro and a grid of post cards. %>
<%= render "shared/header" %>

<%# Intro %>
<section class="mx-auto max-w-[1180px] px-6 pt-10 pb-12 md:pt-14">
  <%= render "posts/breadcrumb", crumbs: [ [ "Home", root_path ], [ section ] ] %>

  <h1 class="mt-7 font-serif text-[clamp(40px,6vw,72px)] leading-[1.02] font-medium tracking-[-1px] text-balance">
    <%= heading %>
  </h1>
  <p class="mt-5 max-w-[640px] text-[17px] leading-[1.5] text-pretty text-muted"><%= intro %></p>
</section>

<%# Posts %>
<section class="mx-auto max-w-[1180px] px-6 pb-28" aria-label="<%= section %>">
  <% if posts.any? %>
    <div class="grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
      <%= render partial: "posts/card", collection: posts, as: :post, locals: { cta: } %>
    </div>
  <% else %>
    <p class="rounded-[18px] bg-white/70 p-8 text-base text-muted">New stories are on their way. Check back soon.</p>
  <% end %>
</section>
