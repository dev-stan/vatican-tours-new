<% content_for :title, "Contact Us — Vatican Tours Inc" %>

<% input_class = "mt-1 w-full rounded-[12px] border border-line bg-white px-4 text-base outline-none transition-colors placeholder:text-[#b5ada5] focus:border-ink/60 aria-invalid:border-terracotta-deep" %>
<% errors = @contact_message.errors %>

<%= render "shared/header" %>

<%# Intro %>
<section class="mx-auto max-w-[1180px] px-6 pt-14 pb-12 md:pt-20">
  <p class="text-[13px] font-semibold tracking-[.18em] text-terracotta-deep uppercase">Contact</p>
  <h1 class="mt-4 font-serif text-[clamp(40px,6vw,72px)] leading-[1.02] font-medium tracking-[-1px] text-balance">
    Talk to <em class="font-normal">Someone in Rome</em>
  </h1>
  <p class="mt-5 max-w-[620px] text-[17px] leading-[1.5] text-pretty text-muted">
    Questions about a tour, an adapted route, or a booking you’ve already made? Write to us and a real person from our team will answer, usually the same day.
  </p>
</section>

<section class="mx-auto grid max-w-[1180px] gap-10 px-6 pb-28 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.4fr)] lg:gap-16">
  <%# Direct channels %>
  <div>
    <h2 class="text-[13px] font-semibold tracking-[.18em] text-muted uppercase">Reach us directly</h2>
    <ul class="mt-5 space-y-3">
      <% contact_channels.each do |contact| %>
        <li>
          <% inner = capture do %>
            <span class="flex size-10 shrink-0 items-center justify-center rounded-full bg-white text-ink"><%= contact_icon(contact[:icon]) %></span>
            <span class="text-base">
              <%= contact[:label] %>
              <% if contact[:note] %><span class="ml-1 text-[13px] text-muted"><%= contact[:note] %></span><% end %>
            </span>
          <% end %>
          <% if contact[:href] %>
            <%= link_to inner, contact[:href], class: "flex items-center gap-4 hover:text-terracotta-deep",
                  **(contact[:href].start_with?("http") ? { target: "_blank", rel: "noopener" } : {}) %>
          <% else %>
            <span class="flex items-center gap-4"><%= inner %></span>
          <% end %>
        </li>
      <% end %>
    </ul>

    <div class="mt-10 rounded-[18px] bg-rome-soft p-6">
      <h3 class="text-base font-semibold">Already booked?</h3>
      <p class="mt-2 text-[15px] leading-[1.55] text-ink/75">
        Include your booking reference (it starts with <span class="font-medium">VTI-</span>) so we can find it straight away.
        Most tours can be cancelled free of charge up to 24 hours before the start time.
      </p>
    </div>
  </div>

  <%# Form %>
  <div class="rounded-[24px] bg-white p-6 shadow-[0_24px_60px_-24px_rgba(40,25,10,.25)] sm:p-10">
    <% if notice %>
      <div class="flex items-start gap-4" role="status">
        <span class="flex size-10 shrink-0 items-center justify-center rounded-full bg-forest text-white" aria-hidden="true">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M2.5 8.5l3.5 3.5 7.5-8"/></svg>
        </span>
        <div>
          <h2 class="font-serif text-[26px] leading-[1.15] font-medium">Message sent</h2>
          <p class="mt-2 text-base leading-[1.5] text-ink/75"><%= notice %></p>
          <%= link_to "Send another message", contact_path, class: "mt-5 inline-block text-[15px] underline underline-offset-4 hover:text-terracotta-deep" %>
        </div>
      </div>
    <% else %>
      <h2 class="font-serif text-[clamp(26px,3vw,32px)] leading-[1.1] font-medium">Send us a <em class="font-normal">message</em></h2>

      <%= form_with model: @contact_message, url: contact_path, class: "mt-7 grid gap-5 sm:grid-cols-2" do |form| %>
        <% [ [ :name, :text_field, "Your name", { autocomplete: "name" } ],
             [ :email, :email_field, "Email", { autocomplete: "email" } ] ].each do |field, helper, label, options| %>
          <div>
            <%= form.label field, label, class: "text-[13px] text-muted" %>
            <%= form.public_send helper, field, required: true, class: "#{input_class} h-12",
                  aria: { invalid: errors[field].any?, describedby: ("#{field}-error" if errors[field].any?) }, **options %>
            <% if errors[field].any? %>
              <p id="<%= field %>-error" class="mt-1.5 text-[13px] text-terracotta-deep"><%= errors.full_messages_for(field).first %></p>
            <% end %>
          </div>
        <% end %>

        <div class="sm:col-span-2">
          <%= form.label :body, "Message", class: "text-[13px] text-muted" %>
          <%= form.text_area :body, required: true, rows: 6, maxlength: 5000, class: "#{input_class} py-3",
                placeholder: "Tell us your dates, group size, and anything we should know.",
                aria: { invalid: errors[:body].any?, describedby: ("body-error" if errors[:body].any?) } %>
          <% if errors[:body].any? %>
            <p id="body-error" class="mt-1.5 text-[13px] text-terracotta-deep"><%= errors.full_messages_for(:body).first %></p>
          <% end %>
        </div>

        <%# Honeypot: hidden from people and screen readers %>
        <div class="hidden" aria-hidden="true">
          <%= form.label :website, "Leave this empty" %>
          <%= form.text_field :website, tabindex: -1, autocomplete: "off" %>
        </div>

        <div class="flex flex-wrap items-center gap-x-6 gap-y-3 sm:col-span-2">
          <%= form.submit "Send message", class: "h-[52px] cursor-pointer rounded-full bg-ink px-8 text-base text-white transition-colors hover:bg-black" %>
          <p class="text-[13px] leading-[1.5] text-muted">
            We only use your details to reply. See our <%= link_to "privacy policy", privacy_path, class: "underline underline-offset-2 hover:text-ink" %>.
          </p>
        </div>
      <% end %>
    <% end %>
  </div>
</section>
