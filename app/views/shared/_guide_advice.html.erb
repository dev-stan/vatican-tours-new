<%# locals: (advice:, photo: "guides/guide.webp") -%>
<%# Floating "Guide's advice" pill pinned to the bottom-right corner that opens a modal of local tips. %>
<%# `advice` maps each location to { title:, tips: [] }; on the home page the tour-filter controller shows the selected location's title and tips. %>
<div data-controller="guide-advice">
  <button type="button" data-action="guide-advice#open" aria-haspopup="dialog"
          class="group fixed right-4 bottom-4 z-40 flex cursor-pointer items-center gap-3 rounded-full border border-line/70 bg-[#f7f2ec]/95 py-1.5 pr-5 pl-1.5 text-left shadow-[0_2px_10px_rgba(0,0,0,.06)] backdrop-blur-sm transition-shadow hover:shadow-[0_4px_16px_rgba(0,0,0,.1)] md:right-6 md:bottom-6">
    <span class="relative shrink-0">
      <%= image_tag photo, alt: "", class: "block size-9 rounded-full object-cover" %>
      <span class="absolute -right-0.5 -bottom-0.5 size-3 rounded-full border-2 border-[#f7f2ec] bg-forest"></span>
    </span>
    <span class="leading-tight">
      <span class="block text-[10px] tracking-[1.5px] text-muted uppercase">Guide’s advice</span>
      <span class="mt-0.5 flex items-center gap-1.5 font-serif text-[15px] italic">
        <span data-tour-filter-target="adviceTitle"><%= advice["All Locations"][:title] %></span>
        <svg width="11" height="11" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" class="transition-transform group-hover:translate-x-0.5" aria-hidden="true"><path d="M1 8h14"/><path d="M10 3l5 5-5 5"/></svg>
      </span>
    </span>
  </button>

  <dialog data-guide-advice-target="dialog" data-action="click->guide-advice#closeOnBackdrop" aria-labelledby="guide-advice-heading"
          class="m-auto w-[min(440px,calc(100%-32px))] rounded-[14px] bg-cream p-0 text-ink shadow-[0_12px_40px_rgba(0,0,0,.18)] backdrop:bg-[rgba(20,30,40,.35)] backdrop:backdrop-blur-[2px] md:mr-6 md:mb-24">
    <div class="px-6 pt-5 pb-6">
      <div class="flex items-center gap-3.5">
        <%= image_tag photo, alt: "", class: "size-12 shrink-0 rounded-full object-cover ring-1 ring-line ring-offset-2 ring-offset-cream" %>
        <p id="guide-advice-heading" class="text-[10px] tracking-[1.5px] text-muted uppercase">Guide’s advice</p>
        <button type="button" data-action="guide-advice#close" aria-label="Close"
                class="-mr-2 ml-auto flex size-8 cursor-pointer items-center justify-center rounded-full text-muted hover:bg-stepper hover:text-ink">
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M1.5 1.5l9 9M10.5 1.5l-9 9"/></svg>
        </button>
      </div>

      <% advice.each do |location, entry| %>
        <section data-tour-filter-target="advicePanel" data-location="<%= location %>" <%= "hidden" unless location == "All Locations" %>>
          <h2 class="mt-4 font-serif text-[26px] leading-[1.1] font-medium"><%= entry[:title] %></h2>
          <ol class="mt-4 space-y-3.5 border-t border-line pt-4">
            <% entry[:tips].each_with_index do |tip, i| %>
              <li class="flex gap-3.5 text-[14px] leading-[1.45]">
                <span class="mt-px w-4 shrink-0 font-serif text-[15px] text-muted-serif italic"><%= i + 1 %></span>
                <span class="text-pretty"><%= tip %></span>
              </li>
            <% end %>
          </ol>
        </section>
      <% end %>
    </div>
  </dialog>
</div>
