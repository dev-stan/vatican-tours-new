<% pin_icon = '<svg width="14" height="15" viewBox="0 0 14 15" fill="none" stroke="currentColor" stroke-width="1.1" aria-hidden="true"><path d="M7 14s5-4.6 5-8.2A5 5 0 0 0 2 5.8C2 9.4 7 14 7 14z"/><circle cx="7" cy="6" r="1.8"/></svg>'.html_safe %>
<% mail_icon = '<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.1" aria-hidden="true"><rect x="1.5" y="3" width="13" height="10" rx="1.5"/><path d="M2 4l6 5 6-5"/></svg>'.html_safe %>
<% phone_icon = '<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.1" aria-hidden="true"><path d="M5.6 1.5H3.2c-.9 0-1.7.8-1.6 1.7.6 6 5.2 10.6 11.2 11.2.9.1 1.7-.7 1.7-1.6v-2.4l-3-1.3-1.5 1.5a8.6 8.6 0 0 1-3.6-3.6L7 5.5z"/></svg>'.html_safe %>
<% chat_icon = '<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.1" aria-hidden="true"><path d="M8 1.5c3.6 0 6.5 2.6 6.5 5.8S11.6 13 8 13c-.8 0-1.6-.1-2.3-.4L2 14.5l1-3.2C2.1 10.2 1.5 8.8 1.5 7.3 1.5 4.1 4.4 1.5 8 1.5z"/></svg>'.html_safe %>

<% contacts = [
  { icon: mail_icon, label: "tours@vaticantoursinc.com", href: "mailto:tours@vaticantoursinc.com" },
  { icon: phone_icon, label: "+39 334 438 6561", href: "tel:+393344386561" },
  { icon: chat_icon, label: "+39 334 438 6561", note: "WhatsApp", href: "https://wa.me/393344386561" },
  { icon: pin_icon, label: "Rome, Italy" }
] %>

<footer class="bg-ink text-cream">
  <div class="mx-auto max-w-[1180px] px-6">
    <%# Newsletter %>
    <section class="grid gap-8 border-b border-white/15 py-16 md:grid-cols-[minmax(0,1fr)_minmax(0,460px)] md:items-end md:gap-16 md:py-20" aria-labelledby="newsletter-heading">
      <div>
        <p class="text-[13px] font-semibold tracking-[.18em] text-terracotta uppercase">Letters from Rome</p>
        <h2 id="newsletter-heading" class="mt-4 font-serif text-[clamp(32px,4vw,48px)] leading-[1.05] font-medium text-balance">
          Stay Close to <em class="font-normal">Italy</em>
        </h2>
        <p class="mt-4 max-w-[460px] text-[15px] leading-[1.5] text-pretty text-cream/70">
          A short note each month with new tours, quieter times to visit, and what our guides are seeing around the city.
        </p>
      </div>

      <div data-controller="newsletter">
        <form class="flex flex-col gap-3 sm:flex-row" data-newsletter-target="form" data-action="newsletter#subscribe">
          <label for="newsletter-email" class="sr-only">Email address</label>
          <input id="newsletter-email" type="email" name="email" required autocomplete="email" placeholder="Your email address"
                 class="h-[52px] w-full min-w-0 rounded-full sm:flex-1 border border-white/25 bg-white/[.06] px-6 text-base text-cream placeholder:text-cream/45 focus:border-terracotta focus:outline-none">
          <button type="submit" class="h-[52px] shrink-0 cursor-pointer rounded-full bg-terracotta px-8 text-base font-medium text-ink transition-colors hover:bg-cream">Sign Up</button>
        </form>
        <p class="mt-3 pl-6 text-[13px] text-cream/50" data-newsletter-target="note">No spam. Unsubscribe whenever you like.</p>
        <p class="flex items-center gap-3 font-serif text-xl italic" role="status" data-newsletter-target="done" hidden>
          <span class="flex size-9 shrink-0 items-center justify-center rounded-full bg-forest not-italic" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M2.5 8.5l3.5 3.5 7.5-8"/></svg>
          </span>
          Grazie! Your first letter is on its way.
        </p>
      </div>
    </section>

    <%# Brand, contact, booking %>
    <div class="grid gap-12 py-14 md:grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)_minmax(0,1fr)] md:gap-10">
      <div>
        <%= link_to root_path, class: "inline-flex items-center gap-3" do %>
          <span class="flex size-[30px] items-center justify-center rounded-full border-[1.5px] border-cream font-serif text-base">V</span>
          <span class="text-[15px] font-medium tracking-[3px]">VATICAN TOURS INC</span>
        <% end %>
        <p class="mt-5 max-w-[300px] font-serif text-[17px] leading-[1.4] text-pretty text-cream/70 italic">
          Small-group and private tours across Italy, planned by people who live here.
        </p>
      </div>

      <div>
        <h2 class="text-[13px] font-semibold tracking-[.18em] text-cream/50 uppercase">Contact</h2>
        <ul class="mt-5 space-y-3.5 text-[15px]">
          <% contacts.each do |contact| %>
            <li>
              <% if contact[:href] %>
                <%= link_to contact[:href], class: "group inline-flex items-center gap-3 hover:text-terracotta",
                      **(contact[:href].start_with?("http") ? { target: "_blank", rel: "noopener" } : {}) do %>
                  <span class="text-cream/55 group-hover:text-terracotta"><%= contact[:icon] %></span>
                  <span><%= contact[:label] %></span>
                  <% if contact[:note] %><span class="text-[13px] text-cream/50"><%= contact[:note] %></span><% end %>
                <% end %>
              <% else %>
                <span class="inline-flex items-center gap-3">
                  <span class="flex w-4 justify-center text-cream/55"><%= contact[:icon] %></span>
                  <%= contact[:label] %>
                </span>
              <% end %>
            </li>
          <% end %>
        </ul>
      </div>

      <div class="md:justify-self-end">
        <h2 class="text-[13px] font-semibold tracking-[.18em] text-cream/50 uppercase">Plan Your Visit</h2>
        <%= link_to root_path(anchor: "tours"), class: "group mt-5 inline-flex items-baseline gap-3 font-serif text-[clamp(28px,3vw,34px)] leading-[1.1] font-medium hover:text-terracotta" do %>
          <span>Book a <em class="font-normal">Journey</em></span>
          <span class="font-sans text-[0.8em] transition-transform group-hover:translate-x-1.5" aria-hidden="true">→</span>
        <% end %>
        <p class="mt-3 max-w-[260px] text-[13px] leading-[1.5] text-cream/50">
          Free cancellation up to 24 hours before most tours.
        </p>
      </div>
    </div>

    <div class="flex flex-wrap items-center justify-between gap-3 border-t border-white/15 py-6 text-[13px] text-cream/45">
      <p>© <%= Date.current.year %> Vatican Tours Inc</p>
      <p class="font-serif text-sm italic">Italy, seen up close.</p>
    </div>
  </div>
</footer>
