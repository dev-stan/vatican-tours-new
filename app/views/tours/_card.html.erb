<article class="relative flex flex-col rounded-[14px] shadow-[0_1px_2px_rgba(0,0,0,.04)] <%= tour_card_tint(tour) %>"
         data-tour-filter-target="card"
         data-location="<%= tour.location %>"
         data-categories="<%= tour_categories(tour).to_json %>">
  <div class="relative h-52 overflow-hidden rounded-t-[14px] bg-black/[.04]">
    <% if (photo = tour.photos.first) %>
      <%= image_tag photo, alt: "", loading: "lazy", class: "absolute inset-0 block size-full object-cover" %>
    <% end %>
    <% if tour.badge %>
      <span class="absolute top-2.5 left-2.5 rounded-full bg-black/40 px-3 py-1 text-[15px] leading-tight text-white backdrop-blur-sm"><%= tour.badge.humanize %></span>
    <% end %>
  </div>

  <div class="flex flex-1 flex-col px-2.5 pt-2.5 pb-[18px]">
    <div class="flex items-center justify-between px-0.5 text-[13px] text-muted">
      <span class="flex items-center gap-2">
        <svg width="14" height="15" viewBox="0 0 14 15" fill="none" stroke="currentColor" stroke-width="1.1" aria-hidden="true"><path d="M7 14s5-4.6 5-8.2A5 5 0 0 0 2 5.8C2 9.4 7 14 7 14z"/><circle cx="7" cy="6" r="1.8"/></svg>
        <%= tour.location %>
      </span>
      <span class="flex items-center gap-1.5">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.1" aria-hidden="true"><circle cx="8" cy="8" r="7"/><path d="M8 4v4.3l2.6 1.6"/></svg>
        <%= tour_duration(tour) %>
      </span>
    </div>
    <h3 class="mt-3.5 font-serif text-[21px] leading-[1.12] font-medium text-pretty">
      <%= link_to tour.title, tour_path(tour), class: "after:absolute after:inset-0 after:rounded-[14px]" %>
    </h3>
    <p class="mt-3 font-serif text-sm leading-[1.15] text-pretty text-muted-serif italic"><%= tour.headline %></p>
    <div class="mt-auto flex items-baseline gap-2 pt-[46px] text-[15px]">
      <span><%= tour_price_label(tour) %></span><strong class="font-semibold"><%= tour_price(tour) %></strong>
    </div>
  </div>

  <div class="absolute right-0 -bottom-2 flex size-[35px] items-center justify-center rounded-full bg-forest" title="<%= tour.transport.humanize %>">
    <%= render "tours/transport_icon", transport: tour.transport %>
  </div>
</article>
