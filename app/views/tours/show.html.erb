<% content_for :title, "#{@tour.title} — Vatican Tours Inc" %>
<% if @booking_options %>
  <%# Room for the fixed mobile booking bar so it never covers the footer %>
  <% content_for :body_class, "max-lg:pb-[73px]" %>
<% end %>

<% details = tour_finer_details(@tour) %>
<% included, excluded = @tour.inclusions.partition(&:included) %>
<% gallery_widths = %w[w-[420px] w-[380px] w-[380px]] %>

<%# Quick facts: [label, icon, value], shown in the region-coloured strip under the header %>
<% quick_facts = [
     (["Format", '<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true"><circle cx="6" cy="5" r="2.5"/><path d="M1.5 14c.6-2.6 2.3-4 4.5-4s3.9 1.4 4.5 4"/><path d="M10.5 2.7a2.5 2.5 0 0 1 0 4.6"/><path d="M12.3 10.3c1.1.6 1.9 1.8 2.2 3.7"/></svg>', tour_format(@tour)] if tour_format(@tour)),
     ["Duration", '<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true"><circle cx="8" cy="8" r="7"/><path d="M8 4v4.3l2.6 1.6"/></svg>', tour_duration(@tour)],
     ["Location", '<svg width="14" height="16" viewBox="0 0 14 15" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true"><path d="M7 14s5-4.6 5-8.2A5 5 0 0 0 2 5.8C2 9.4 7 14 7 14z"/><circle cx="7" cy="6" r="1.8"/></svg>', @tour.region],
     (["Languages", '<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true"><path d="M8 1.5c3.6 0 6.5 2.6 6.5 5.8S11.6 13 8 13c-.8 0-1.6-.1-2.3-.4L2 14.5l1-3.2C2.1 10.2 1.5 8.8 1.5 7.3 1.5 4.1 4.4 1.5 8 1.5z"/></svg>', "Live guide in #{tour_languages(@tour)}"] if @tour.languages.any?)
   ].compact %>

<%# Header %>
<%= render "shared/header" %>

<%# Quick facts %>
<div class="bg-region text-white" style="<%= region_style(@tour) %>">
  <ul class="no-scrollbar mx-auto flex max-w-[1180px] items-center overflow-x-auto px-6 py-3.5 text-[15px] whitespace-nowrap max-md:[mask-image:linear-gradient(to_right,#000_85%,transparent)]" aria-label="Tour at a glance">
    <% quick_facts.each_with_index do |(label, icon, value), i| %>
      <% if i > 0 %><li class="mx-6 h-6 w-px shrink-0 bg-white/30" aria-hidden="true"></li><% end %>
      <li class="flex shrink-0 items-center gap-3">
        <span class="flex size-9 shrink-0 items-center justify-center rounded-full bg-white/15"><%= icon.html_safe %></span>
        <span><span class="sr-only"><%= label %>: </span><%= value %></span>
      </li>
    <% end %>
    <li class="w-6 shrink-0 md:hidden" aria-hidden="true"></li>
  </ul>
</div>

<%= tag.div class: "mx-auto grid max-w-[1180px] grid-cols-[minmax(0,1fr)] px-6 lg:grid-cols-[minmax(0,1fr)_430px] lg:gap-14", style: region_style(@tour),
            data: (@booking_options ? { controller: "booking", booking_options_value: @booking_options.to_json,
                                        booking_today_value: Date.current.iso8601 } : {}) do %>

  <%# Tour details %>
  <div class="pt-10 pb-16 lg:pt-20 lg:pb-28">
    <nav aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-3 text-sm text-muted">
        <li><%= link_to "Home", root_path, class: "hover:text-ink" %></li>
        <li aria-hidden="true" class="text-[#c4bdb5]">/</li>
        <li><%= link_to @tour.region, root_path(anchor: "tours"), class: "hover:text-ink" %></li>
        <li aria-hidden="true" class="text-[#c4bdb5]">/</li>
        <li class="text-ink" aria-current="page"><%= @tour.title %></li>
      </ol>
    </nav>

    <p class="mt-7 text-sm font-semibold tracking-[.16em] text-region uppercase"><%= @tour.title %></p>
    <h1 class="mt-6 font-serif text-[clamp(34px,4.4vw,50px)] leading-[1.1] font-medium tracking-[-.5px] text-pretty">
      <%= @tour.subtitle.presence || @tour.title %>
    </h1>

    <%# Highlights %>
    <% if @tour.highlights.any? %>
      <section class="mt-16 lg:mt-20" aria-labelledby="highlights-heading">
        <h2 id="highlights-heading" class="border-b border-ink/25 pb-4 font-serif text-[23px] font-medium text-muted-serif">Tour Highlights</h2>
        <div class="mt-12 grid gap-x-14 gap-y-10 sm:grid-cols-2">
          <% @tour.highlights.each do |highlight| %>
            <div>
              <h3 class="text-[17px] font-semibold"><%= highlight.title %></h3>
              <p class="mt-3 text-base leading-[1.5]"><%= highlight.body %></p>
            </div>
          <% end %>
        </div>
      </section>
    <% end %>

    <%# What we think, and what travellers told us %>
    <% if @tour.what_we_think.present? || @tour.what_customers_think.present? %>
      <section class="relative mt-16 overflow-hidden rounded-[24px] bg-region-soft px-6 pt-8 pb-6 sm:px-9 sm:pt-10 sm:pb-8" aria-label="Our take on this tour">
        <%# A Roman arch, drawn faintly behind the copy %>
        <svg class="pointer-events-none absolute -top-8 -right-14 h-[240px] w-[212px] text-region/20 sm:-right-4" viewBox="0 0 300 340" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path d="M30 340V150a120 120 0 0 1 240 0v190"/>
          <path d="M70 340V155a80 80 0 0 1 160 0v185"/>
          <path d="M110 340V160a40 40 0 0 1 80 0v180"/>
        </svg>

        <% if @tour.what_we_think.present? %>
          <div class="relative max-w-[620px]">
            <p class="flex items-center gap-3 text-[13px] font-semibold tracking-[.16em] text-ink/70 uppercase">
              <span class="h-px w-8 bg-region" aria-hidden="true"></span>Our take
            </p>
            <h2 class="mt-3 font-serif text-[clamp(24px,2.6vw,30px)] leading-[1.15] font-medium tracking-[-.4px] text-balance">What we think about this tour</h2>
            <p class="mt-3 text-base leading-[1.6] whitespace-pre-line"><%= @tour.what_we_think %></p>
          </div>
        <% end %>

        <% if @tour.what_customers_think.present? %>
          <figure class="relative rounded-[18px] bg-white px-5 pt-8 pb-5 sm:px-8 sm:pt-9 sm:pb-6 <%= @tour.what_we_think.present? ? "mt-8" : "mt-3" %>">
            <span class="pointer-events-none absolute -top-7 left-4 font-serif text-[88px] leading-none text-region select-none sm:left-6" aria-hidden="true">“</span>
            <h2 class="mt-3 font-serif text-[clamp(24px,2.6vw,30px)] leading-[1.15] font-medium tracking-[-.4px] text-balance">What travellers shared with us about this tour</h2>
            <blockquote class="mt-3 border-l-2 border-region pl-4 text-base leading-[1.6] text-pretty italic">
              <%= @tour.what_customers_think %>
            </blockquote>
            <% if @tour.customer_name.present? || @tour.customer_origin.present? %>
              <figcaption class="mt-5 flex items-center gap-3">
                <span class="flex size-9 shrink-0 items-center justify-center rounded-full bg-region font-serif text-base font-medium text-white" aria-hidden="true">
                  <%= (@tour.customer_name.presence || @tour.customer_origin).strip.first.upcase %>
                </span>
                <div>
                  <% if @tour.customer_name.present? %><p class="text-[15px] font-semibold"><%= @tour.customer_name %></p><% end %>
                  <% if @tour.customer_origin.present? %><p class="text-sm text-muted"><%= @tour.customer_origin %></p><% end %>
                </div>
              </figcaption>
            <% end %>
          </figure>
        <% end %>
      </section>
    <% end %>

    <%# Gallery %>
    <% if @tour.photos.attached? %>
      <div class="no-scrollbar mt-14 -mr-6 flex snap-x snap-mandatory gap-4 overflow-x-auto pr-6 lg:mr-0 lg:pr-0" role="group" aria-label="Tour photos" tabindex="0">
        <% @tour.photos.each_with_index do |photo, i| %>
          <%= image_tag photo, alt: "#{@tour.title}, photo #{i + 1}", loading: "lazy",
                class: "h-[240px] max-w-[85%] shrink-0 snap-start rounded-[16px] object-cover sm:h-[320px] #{gallery_widths[i % gallery_widths.size]}" %>
        <% end %>
      </div>
    <% end %>

    <%# Details %>
    <% if details.any? %>
      <section class="mt-20" aria-labelledby="details-heading">
        <h2 id="details-heading" class="border-b border-ink/25 pb-4 font-serif text-[23px] font-medium text-muted-serif">The Finer Details</h2>
        <div class="mt-8 space-y-6 text-base leading-[1.65]">
          <% details.each do |paragraph| %>
            <p><%= paragraph %></p>
          <% end %>
        </div>
      </section>
    <% end %>

    <%# Included %>
    <% if @tour.inclusions.any? %>
      <section class="mt-20" aria-labelledby="included-heading">
        <h2 id="included-heading" class="border-b border-ink/25 pb-4 font-serif text-[23px] font-medium text-muted-serif">What’s Included</h2>
        <div class="mt-8 grid gap-x-14 gap-y-4 text-base leading-[1.4] sm:grid-cols-2">
          <ul class="space-y-4">
            <% included.each do |item| %>
              <li class="flex gap-4">
                <svg class="mt-1 shrink-0" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M2.5 8.5l3.5 3.5 7.5-8"/></svg>
                <span><span class="sr-only">Included: </span><%= item.label %></span>
              </li>
            <% end %>
          </ul>
          <ul class="space-y-4 text-muted">
            <% excluded.each do |item| %>
              <li class="flex gap-4">
                <svg class="mt-1 shrink-0" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true"><path d="M3.5 3.5l9 9M12.5 3.5l-9 9"/></svg>
                <span><span class="sr-only">Not included: </span><%= item.label %></span>
              </li>
            <% end %>
          </ul>
        </div>
      </section>
    <% end %>

    <%# Good to know %>
    <% if @tour.tour_facts.any? %>
      <section class="mt-20" aria-labelledby="know-heading">
        <h2 id="know-heading" class="border-b border-ink/25 pb-4 font-serif text-[23px] font-medium text-muted-serif">Good to Know</h2>
        <dl>
          <% @tour.tour_facts.each do |fact| %>
            <div class="grid gap-2 border-b border-line py-5 sm:grid-cols-[35%_1fr] sm:gap-6">
              <dt class="text-base font-semibold"><%= fact.label %></dt>
              <dd class="text-base leading-[1.5] whitespace-pre-line"><%= fact.body %></dd>
            </div>
          <% end %>
        </dl>
      </section>
    <% end %>
  </div>

  <% if @booking_options %>
  <%# Booking card %>
  <aside class="pb-28 lg:pt-7" aria-label="Book this tour">
    <div class="sticky scroll-mt-6 rounded-[22px] bg-white p-[26px] transition-[top] duration-200" data-booking-target="card">
      <%# Group/private toggle, only for tours that sell both %>
      <% if @group_tickets.any? && @private_tickets.any? %>
        <div class="mb-6 grid grid-cols-2 rounded-full bg-stepper p-1 text-sm" role="group" aria-label="Tour type">
          <% { "group" => "Small Group", "private" => "Private" }.each do |mode, label| %>
            <button type="button" class="cursor-pointer rounded-full py-2 transition-colors aria-pressed:bg-white aria-pressed:shadow-[0_1px_3px_rgba(0,0,0,.1)]"
                    aria-pressed="<%= mode == "group" %>" data-mode="<%= mode %>"
                    data-booking-target="mode" data-action="booking#selectMode"><%= label %></button>
          <% end %>
        </div>
      <% end %>

      <div class="flex flex-wrap items-center justify-between gap-2 text-[15px] text-muted">
        <span data-booking-target="fromPrice">Starting from <%= euros((@group_tickets.find(&:adult?) || @private_tickets.first).price_cents) %></span>
      </div>

      <div class="mt-5 space-y-5 border-b border-line pb-6">
        <%# One stepper per group ticket type, or a single one for a private-only tour; in private mode the counts make up the party size. %>
        <% @booking_options[:guests].each do |guest| %>
          <div class="flex items-center justify-between gap-4">
            <div>
              <p id="guests-<%= guest[:id] %>-label" class="text-base"><%= guest[:name].pluralize %></p>
              <p class="mt-0.5 text-[13px] text-muted" data-booking-target="note" data-guest="<%= guest[:id] %>"></p>
            </div>
            <div class="flex items-center" role="group" aria-labelledby="guests-<%= guest[:id] %>-label">
              <button type="button" class="flex size-[34px] cursor-pointer items-center justify-center rounded-[6px] bg-stepper text-lg transition-opacity disabled:cursor-default disabled:opacity-40"
                      aria-label="Remove one <%= guest[:name].downcase %>" data-step="down"
                      data-booking-target="step" data-booking-guest-param="<%= guest[:id] %>" data-action="booking#decrement">–</button>
              <span class="w-[38px] text-center text-lg" aria-live="polite" data-booking-target="count" data-guest="<%= guest[:id] %>"></span>
              <button type="button" class="flex size-[34px] cursor-pointer items-center justify-center rounded-[6px] bg-stepper text-lg transition-opacity disabled:cursor-default disabled:opacity-40"
                      aria-label="Add one <%= guest[:name].downcase %>" data-step="up"
                      data-booking-target="step" data-booking-guest-param="<%= guest[:id] %>" data-action="booking#increment">+</button>
            </div>
          </div>
        <% end %>
      </div>

      <%# Calendar %>
      <div class="mt-6 rounded-[20px] border border-line px-3 pt-4 pb-2">
        <div class="flex items-center justify-between px-2">
          <button type="button" class="flex size-8 cursor-pointer items-center justify-center rounded-full hover:bg-stepper disabled:cursor-default disabled:opacity-30 disabled:hover:bg-transparent"
                  aria-label="Previous month" data-booking-target="prev" data-action="booking#previousMonth">
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M10 3L5 8l5 5"/></svg>
          </button>
          <p class="text-[17px]" aria-live="polite" data-booking-target="month"></p>
          <button type="button" class="flex size-8 cursor-pointer items-center justify-center rounded-full hover:bg-stepper disabled:cursor-default disabled:opacity-30 disabled:hover:bg-transparent"
                  aria-label="Next month" data-booking-target="next" data-action="booking#nextMonth">
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M6 3l5 5-5 5"/></svg>
          </button>
        </div>
        <div class="mt-4 grid grid-cols-7 text-center text-[13px] text-muted" aria-hidden="true">
          <% %w[Sun Mon Tue Wed Thu Fri Sat].each do |day| %><span><%= day %></span><% end %>
        </div>
        <div class="mt-2 grid grid-cols-7" data-booking-target="days"></div>
      </div>

      <p class="mt-7 border-b border-line pb-4 text-[15px] font-medium tracking-[.12em] uppercase" aria-live="polite" data-booking-target="dateLabel"></p>

      <%# Start times %>
      <p id="times-label" class="mt-5 text-base">Start times</p>
      <div class="mt-3 space-y-2.5" role="group" aria-labelledby="times-label" data-booking-target="slots"></div>

      <div class="mt-6 flex items-baseline justify-between border-t border-line pt-6">
        <span class="text-[15px] text-muted" data-booking-target="totalLabel"></span>
        <span class="text-[24px] font-semibold" aria-live="polite" data-booking-target="total"></span>
      </div>

      <button type="button" class="mt-5 h-[52px] w-full cursor-pointer rounded-full bg-region text-base text-white transition-colors hover:bg-region-deep disabled:cursor-default disabled:opacity-40"
              data-booking-target="bookButton" data-action="booking#book">Book Now</button>

      <%# Contact details, expanded by Book Now. Turbo sets aria-busy on the form while it submits. %>
      <div class="grid grid-rows-[0fr] transition-[grid-template-rows] duration-300 ease-out data-expanded:grid-rows-[1fr]" data-booking-target="details" inert>
        <div class="overflow-hidden">
          <%= form_with scope: :booking, url: bookings_path, class: "group", data: { booking_target: "form" } do |form| %>
            <div data-booking-target="fields"></div>

            <p class="mt-6 text-base">Your details</p>
            <div class="mt-3 space-y-3">
              <% input_class = "mt-1 h-12 w-full rounded-[12px] border border-line bg-white px-4 text-base outline-none transition-colors placeholder:text-[#b5ada5] focus:border-ink/60" %>
              <div>
                <%= form.label :name, "Full name", class: "text-[13px] text-muted" %>
                <%= form.text_field :name, required: true, autocomplete: "name", class: input_class, data: { booking_target: "name" } %>
              </div>
              <div>
                <%= form.label :email, class: "text-[13px] text-muted" %>
                <%= form.email_field :email, required: true, autocomplete: "email", class: input_class %>
              </div>
              <div>
                <%= form.label :phone, "Phone", class: "text-[13px] text-muted" %>
                <%= form.telephone_field :phone, required: true, autocomplete: "tel", placeholder: "Include your country code", class: input_class %>
              </div>
            </div>

            <p id="booking-error" class="mt-4 text-[14px] leading-[1.4] text-terracotta-deep empty:hidden" role="alert"></p>

            <button type="submit" class="mt-5 flex h-[52px] w-full cursor-pointer items-center justify-center gap-3 rounded-full bg-region text-base text-white transition-colors hover:bg-region-deep group-aria-busy:cursor-wait group-aria-busy:bg-region/85">
              <svg class="hidden size-5 animate-spin group-aria-busy:block" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <circle cx="12" cy="12" r="9.5" stroke="currentColor" stroke-opacity=".3" stroke-width="2.5"/>
                <path d="M21.5 12A9.5 9.5 0 0 0 12 2.5" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
              </svg>
              <span class="group-aria-busy:hidden">Request Booking · <span data-booking-target="submitTotal"></span></span>
              <span class="hidden group-aria-busy:inline" role="status">Sending your request…</span>
            </button>
          <% end %>
        </div>
      </div>
    </div>
  </aside>

  <%# Mobile booking bar, hidden while the card itself is on screen %>
  <div class="fixed inset-x-0 bottom-0 z-10 flex items-center justify-between gap-4 border-t border-line bg-white px-6 py-3 transition-transform duration-300 lg:hidden" data-booking-target="bar">
    <div>
      <p class="text-[17px] font-semibold" data-booking-target="barTotal"></p>
      <p class="text-[13px] text-muted" data-booking-target="barDate"></p>
    </div>
    <button type="button" class="h-12 cursor-pointer rounded-full bg-region px-7 text-base text-white transition-colors hover:bg-region-deep" data-action="booking#reveal">Choose a time</button>
  </div>
  <% end %>
<% end %>
