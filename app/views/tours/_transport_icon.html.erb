<%# White glyph for the green badge on tour cards: footsteps, a water taxi, or a car. The PNGs are black lines, turned white by brightness-0 invert. %>
<% case transport %>
<% when "boat" %>
  <%= image_tag "icons/boat.png", alt: "", class: "size-6 brightness-0 invert" %>
<% when "car" %>
  <%= image_tag "icons/car.png", alt: "", class: "size-6 brightness-0 invert" %>
<% else %>
  <svg width="18" height="18" viewBox="0 0 18 18" fill="#fff"><ellipse cx="6" cy="6.5" rx="2.6" ry="3.6"/><ellipse cx="6" cy="12.6" rx="1.8" ry="1.4"/><ellipse cx="12" cy="5" rx="2.6" ry="3.6"/><ellipse cx="12" cy="11.1" rx="1.8" ry="1.4"/></svg>
<% end %>
