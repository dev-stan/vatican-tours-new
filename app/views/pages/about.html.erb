<% content_for :title, "About Us — Vatican Tours Inc" %>

<% values = [
  { title: "Planned by locals", body: "Our team lives in Rome. We build every itinerary around the hours, entrances, and quiet corners we know first-hand." },
  { title: "Small groups, or just you", body: "Our group tours stay small so you can hear your guide and see the art. Private tours go at exactly your pace." },
  { title: "Something for every traveler", body: "Families, first-timers, and wheelchair users all have tours designed for them, not adapted as an afterthought." },
  { title: "A real person, the same day", body: "Questions go straight to our team in Rome, not a call center. We usually answer the same day." }
] %>

<%= render "shared/header" %>

<%# Intro %>
<section class="mx-auto max-w-[1180px] px-6 pt-14 pb-14 md:pt-20">
  <p class="text-[13px] font-semibold tracking-[.18em] text-terracotta-deep uppercase">About Us</p>
  <h1 class="mt-4 max-w-[900px] font-serif text-[clamp(40px,6vw,72px)] leading-[1.02] font-medium tracking-[-1px] text-balance">
    Italy, Shown by <em class="font-normal">People Who Live Here</em>
  </h1>
  <p class="mt-5 max-w-[640px] text-[17px] leading-[1.5] text-pretty text-muted">
    Vatican Tours Inc runs small-group and private tours across Italy, from the Vatican Museums and the Sistine Chapel to Florence, Venice, the Amalfi Coast, and Sicily.
  </p>
</section>

<%# Photo band %>
<div class="mx-auto max-w-[1180px] px-6">
  <div class="h-[260px] rounded-[24px] bg-[#3a3a36] bg-cover bg-[center_40%] md:h-[420px]"
       style="background-image: url('<%= image_path("bar-hero.jpg") %>')" role="img" aria-label="A Roman street scene"></div>
</div>

<%# Story %>
<section class="mx-auto grid max-w-[1180px] gap-8 px-6 pt-20 md:grid-cols-[minmax(0,1fr)_minmax(0,1.4fr)] md:gap-16">
  <h2 class="font-serif text-[clamp(30px,3.6vw,42px)] leading-[1.1] font-medium">Why We <em class="font-normal">Do This</em></h2>
  <div class="space-y-5 text-[17px] leading-[1.6] text-ink/80">
    <p>
      Too many visitors see Rome from the back of a crowd, after hours in a queue, on a schedule that isn’t theirs. We started Vatican Tours Inc to offer something better: reserved entry, groups small enough to feel personal, and routes that leave room to linger.
    </p>
    <p>
      Every tour we sell is one we would happily take our own friends on. If you need something different, an adapted route, a slower pace, a stop for the kids, just ask.
    </p>
  </div>
</section>

<%# Values %>
<section class="mx-auto max-w-[1180px] px-6 pt-20" aria-labelledby="values-heading">
  <h2 id="values-heading" class="sr-only">How we work</h2>
  <ul class="grid gap-5 sm:grid-cols-2">
    <% values.each_with_index do |value, i| %>
      <li class="flex gap-5 rounded-[18px] bg-white/70 p-6 sm:p-7">
        <span class="flex size-9 shrink-0 items-center justify-center rounded-full bg-ink font-serif text-[15px] text-white"><%= i + 1 %></span>
        <div class="pt-1">
          <h3 class="text-[17px] font-semibold"><%= value[:title] %></h3>
          <p class="mt-2 text-[15px] leading-[1.55] text-ink/75"><%= value[:body] %></p>
        </div>
      </li>
    <% end %>
  </ul>
</section>

<%# Call to action %>
<section class="mx-auto max-w-[1180px] px-6 pt-20 pb-28">
  <div class="flex flex-col gap-6 rounded-[24px] bg-terracotta px-8 py-10 sm:flex-row sm:items-center sm:justify-between sm:px-12 sm:py-12">
    <div>
      <h2 class="font-serif text-[30px] leading-[1.1] font-normal italic text-balance">Ready to See Italy Up Close?</h2>
      <p class="mt-3 max-w-[520px] text-base leading-[1.55]">Browse our tours, or tell us what you have in mind and we’ll help you plan it.</p>
    </div>
    <div class="flex flex-wrap gap-3">
      <%= link_to "Explore tours", root_path(anchor: "tours"), class: "flex h-[52px] items-center rounded-full bg-ink px-8 text-base text-white transition-colors hover:bg-black" %>
      <%= link_to "Contact us", contact_path, class: "flex h-[52px] items-center rounded-full border border-ink px-8 text-base transition-colors hover:bg-ink hover:text-white" %>
    </div>
  </div>
</section>
