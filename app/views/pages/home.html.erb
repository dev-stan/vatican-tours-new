<% content_for :title, "Vatican Tours Inc — Italy Seen Up Close" %>

<% feature_icons = {
  arrow: '<path d="M1 8h14"/><path d="M10 3l5 5-5 5"/>',
  clock: '<circle cx="8" cy="8" r="6.5"/><path d="M8 4v4.3l2.6 1.6"/>',
  house: '<path d="M2 14V7l6-5 6 5v7z"/>',
  person: '<circle cx="8" cy="5" r="3"/><path d="M2.5 14.5c.8-3 3-4.5 5.5-4.5s4.7 1.5 5.5 4.5"/>'
} %>

<div data-controller="tour-filter"
     data-tour-filter-places-value="<%= @hero_places.to_json %>"
     data-tour-filter-subtitles-value="<%= @hero_subtitles.to_json %>"
     data-tour-filter-section-subtitles-value="<%= @section_subtitles.to_json %>">
  <%# Hero %>
  <section class="relative flex min-h-[540px] flex-col bg-[#3a3a36] bg-cover bg-[center_40%] bg-no-repeat text-white"
           style="background-image: url('<%= image_path("bar-hero.jpg") %>')">
    <div class="pointer-events-none absolute inset-0 bg-[rgba(20,30,40,.32)]"></div>

    <header class="relative flex flex-wrap items-center justify-between gap-4 px-6 py-3.5 md:px-16">
      <%= link_to root_path, class: "flex items-center gap-3 text-white" do %>
        <span class="flex size-[30px] items-center justify-center rounded-full border-[1.5px] border-white font-serif text-base">V</span>
        <span class="text-[15px] font-medium tracking-[3px]">VATICAN TOURS INC</span>
      <% end %>
    </header>

    <div class="relative my-auto flex flex-col items-center px-6 pb-10 text-center md:px-16">
      <h1 class="mt-3.5 font-serif text-[clamp(48px,7.5vw,96px)] leading-none font-medium tracking-[-1px]"><span data-tour-filter-target="place"><%= @hero_places["All Locations"] %></span> Seen Up Close</h1>
      <p class="mt-3 max-w-[760px] text-base" data-tour-filter-target="subtitle"><%= @hero_subtitles["All Locations"] %></p>
    </div>
  </section>

  <%# Intro + features %>
  <section class="mx-auto max-w-[1100px] px-6 pt-[54px] pb-2.5 text-center">
    <h2 class="font-serif text-[clamp(30px,3.6vw,42px)] leading-[1.1] font-medium">See Italy <em class="font-normal">Your Own Way</em></h2>
    <p class="mx-auto mt-3.5 max-w-[600px] text-[15px] leading-[1.4] text-pretty text-muted">
      Wander the Museums at your own pace or walk with a specialist who knows every fresco by heart — either way, you’ll skip the queue and see what most visitors miss.
    </p>

    <div class="mt-12 grid grid-cols-[repeat(auto-fit,minmax(220px,1fr))] gap-7 text-left">
      <% @features.each do |feature| %>
        <div class="flex gap-[22px]">
          <span class="flex size-[31px] shrink-0 items-center justify-center rounded-full bg-ink">
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="#fff" stroke-width="1.2" aria-hidden="true"><%= feature_icons[feature[:icon]].html_safe %></svg>
          </span>
          <div>
            <h3 class="text-sm font-semibold"><%= feature[:title] %></h3>
            <p class="mt-2 text-[13px] leading-[1.35]"><%= feature[:body] %></p>
          </div>
        </div>
      <% end %>
    </div>

    <h2 class="mt-20 font-serif text-[clamp(30px,3.6vw,42px)] leading-[1.1] font-medium" data-tour-filter-target="sectionTitle"><%= @hero_places["All Locations"] %></h2>
    <p class="mx-auto mt-3.5 max-w-[620px] text-[15px] leading-[1.4] text-pretty text-muted" data-tour-filter-target="sectionSubtitle"><%= @section_subtitles["All Locations"] %></p>
  </section>

  <%# Tour browser %>
  <section class="mx-auto max-w-[1260px] px-3 pt-7 pb-[60px]">
    <div class="no-scrollbar flex items-center overflow-x-auto px-3.5 [mask-image:linear-gradient(90deg,#000_92%,transparent)]" role="group" aria-label="Locations">
      <% @locations.each_with_index do |location, i| %>
        <div class="flex shrink-0 items-center">
          <% if i > 0 %><div class="h-[60px] w-px bg-line"></div><% end %>
          <button type="button"
                  class="mx-5 cursor-pointer rounded-full px-[15px] py-[9px] text-[15px] whitespace-nowrap aria-pressed:bg-ink aria-pressed:text-white"
                  aria-pressed="<%= i.zero? %>"
                  data-tour-filter-target="tab"
                  data-location="<%= location %>"
                  data-action="tour-filter#selectLocation"><%= location %></button>
        </div>
      <% end %>
    </div>

    <div class="mt-5 flex flex-wrap items-center justify-between gap-4 px-[15px]">
      <div class="flex flex-wrap items-center gap-x-[18px] gap-y-2.5">
        <% @categories.each do |category| %>
          <label class="flex cursor-pointer items-center gap-2.5 text-[13px] text-muted select-none">
            <input type="checkbox" class="peer sr-only" value="<%= category %>"
                   data-tour-filter-target="category" data-action="tour-filter#filter">
            <span class="flex size-[15px] items-center justify-center rounded-[2px] border border-checkbox bg-white peer-checked:bg-ink peer-checked:[&>svg]:block peer-focus-visible:ring-2 peer-focus-visible:ring-ink/40">
              <svg class="hidden" width="10" height="10" viewBox="0 0 10 10" fill="none" stroke="#fff" stroke-width="1.6" aria-hidden="true"><path d="M1.5 5.2l2.3 2.3 4.7-5"/></svg>
            </span>
            <%= category %>
          </label>
        <% end %>
      </div>

      <div class="flex items-center gap-[15px] text-[15px]">
        <span id="group-size-label">Your Group Size</span>
        <div class="flex items-center" role="group" aria-labelledby="group-size-label">
          <button type="button" class="flex size-[25px] cursor-pointer items-center justify-center bg-stepper text-base" aria-label="Decrease group size" data-action="tour-filter#decrement">–</button>
          <span class="w-[26px] text-center" aria-live="polite" data-tour-filter-target="size">1</span>
          <button type="button" class="flex size-[25px] cursor-pointer items-center justify-center bg-stepper text-base" aria-label="Increase group size" data-action="tour-filter#increment">+</button>
        </div>
      </div>
    </div>

    <div class="mt-9 grid grid-cols-[repeat(auto-fill,minmax(260px,1fr))] gap-[30px]">
      <% @tours.each do |tour| %>
        <article class="relative flex flex-col rounded-[14px] shadow-[0_1px_2px_rgba(0,0,0,.04)] <%= @card_tints.fetch(tour[:location], "bg-white") %>"
                 data-tour-filter-target="card"
                 data-location="<%= tour[:location] %>"
                 data-categories="<%= tour[:categories].to_json %>">
          <div class="relative flex h-52 items-center justify-center overflow-hidden rounded-t-[14px] bg-black/[.04] text-[13px] font-medium text-muted">
            <% if tour[:image] %>
              <%= image_tag tour[:image], alt: tour[:photo], loading: "lazy", class: "absolute inset-0 block size-full object-cover" %>
            <% else %>
              <%= tour[:photo] %>
            <% end %>
          </div>

          <div class="flex flex-1 flex-col px-2.5 pt-2.5 pb-[18px]">
            <div class="flex items-center justify-between px-0.5 text-[13px] text-muted">
              <span class="flex items-center gap-2">
                <svg width="14" height="15" viewBox="0 0 14 15" fill="none" stroke="currentColor" stroke-width="1.1" aria-hidden="true"><path d="M7 14s5-4.6 5-8.2A5 5 0 0 0 2 5.8C2 9.4 7 14 7 14z"/><circle cx="7" cy="6" r="1.8"/></svg>
                <%= tour[:location] %>
              </span>
              <span class="flex items-center gap-1.5">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.1" aria-hidden="true"><circle cx="8" cy="8" r="7"/><path d="M8 4v4.3l2.6 1.6"/></svg>
                <%= tour[:duration] %>
              </span>
            </div>
            <h3 class="mt-3.5 font-serif text-[21px] leading-[1.12] font-medium text-pretty">
              <% if tour[:page] %>
                <%= link_to tour[:title], url_for(controller: "pages", action: tour[:page]), class: "after:absolute after:inset-0 after:rounded-[14px] hover:underline" %>
              <% else %>
                <%= tour[:title] %>
              <% end %>
            </h3>
            <p class="mt-3 font-serif text-sm leading-[1.15] text-pretty text-muted-serif italic"><%= tour[:sub] %></p>
            <div class="mt-auto flex items-baseline gap-2 pt-[46px] text-[15px]">
              <span><%= tour[:price_label] %></span><% if tour[:price] %><strong class="font-semibold"><%= tour[:price] %></strong><% end %>
            </div>
            <% if tour[:reviews] %>
              <div class="mt-4 flex items-center gap-3 pl-0.5 text-[13px] text-muted">
                <span class="tracking-[2px] text-star" aria-hidden="true">★★★★★</span><%= tour[:reviews] %>
              </div>
            <% end %>
          </div>

          <div class="absolute right-0 -bottom-2 flex size-[35px] items-center justify-center rounded-full bg-forest" aria-hidden="true">
            <% if tour[:badge] == :car %>
              <svg width="18" height="18" viewBox="0 0 18 18" fill="#fff"><path fill-rule="evenodd" d="M1.5 12.5V10c0-.6.4-1 1-1.1L5 8.3l2-2.7c.3-.4.6-.6 1.1-.6h3.4c.5 0 .9.2 1.2.6l1.8 2.7 1.3.3c.5.1.9.6.9 1.1v2.8h-1.1a2.4 2.4 0 0 0-4.8 0H7.4a2.4 2.4 0 0 0-4.8 0zM7.6 8.2l1.1-2h1.4v2zM11.1 6.2h1.1l1.3 2h-2.4z"/><circle cx="5" cy="12.8" r="1.8"/><circle cx="13" cy="12.8" r="1.8"/></svg>
            <% else %>
              <svg width="18" height="18" viewBox="0 0 18 18" fill="#fff"><ellipse cx="6" cy="6.5" rx="2.6" ry="3.6"/><ellipse cx="6" cy="12.6" rx="1.8" ry="1.4"/><ellipse cx="12" cy="5" rx="2.6" ry="3.6"/><ellipse cx="12" cy="11.1" rx="1.8" ry="1.4"/></svg>
            <% end %>
          </div>
        </article>
      <% end %>
    </div>

    <p class="my-[60px] text-center font-serif text-lg text-muted-serif italic" data-tour-filter-target="empty" hidden>
      No tours match these filters yet.
    </p>
  </section>
</div>
